# TrustZone/iTrustee deployment artifacts
Trustzone/**/cloud/*.sec
Trustzone/**/cloud/libcombine.so
Trustzone/**/cloud/manifest.txt

# Signing material and generated configuration
Trustzone/**/cloud/TA_cert/private_key.pem
Trustzone/**/cloud/signed_config/config
