/* TestEnclave.edl - Top EDL file. */

enclave {
    
    from "sgx_tsgxssl.edl" import *;
    from "sgx_pthread.edl" import *;

    struct struct_foo_t {
        uint32_t count;
        size_t size;
        [count = count, size = size] char* buf;
    };
    
    /* 
     * uprint - invokes OCALL to display string buffer inside the enclave.
     *  [in]: copy the string buffer to App outside.
     *  [string]: specifies 'str' is a NULL terminated buffer.
     */
    untrusted {
        void uprint([in, string] const char *str);
    };


    trusted {
        public void generate_bool(); 
        public void test_ecall_inner_product([user_check] char** ptr, [user_check] char* ret);
        public void model_training([user_check] unsigned char* ciphertext, int length);
        public void initSystem();
        public void Rand_Num_Generator([user_check] int* Rand_Num,int Lower,int Upper);
        public void decoding([user_check] float*** Xy_train_Output, [user_check] char*** Block_Str, [user_check] int* Participants,int Block_Size,int Num_Block,int Validator);
        public void update([user_check] float** theta_updated_Output, [user_check] float* theta_t, [user_check] float** Xy_train,int M,int Block_Size,int Num_Block,float alpha);
        public void Batch_Str_Decryption([user_check] char**** Batch_Str_D_Output, [user_check] char*** Batch_Str,int Number_Participants, [user_check] unsigned char* ivec);
    };
};
